<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <name>@NAME@</name>
  <summary>Play 16 draughts variants online</summary>
  <branding>
    <color type="primary" scheme_preference="light">#f0d9b5</color>
    <color type="primary" scheme_preference="dark">#8B4513</color>
  </branding>
  <description>
    <p>
      Draughts is a comprehensive game featuring 16 international game variants,
      multiple AI difficulty levels, online multiplayer, and a modern interface.
      It offers engaging gameplay for players of all skill levels with support for local and
      online matches against friends or AI.
    </p>
    <p>Game Features:</p>
    <ul>
      <li>16 international variants including American, Russian, Brazilian, and Frisian</li>
      <li>10 AI difficulty levels from Beginner to Grandmaster</li>
      <li>Online multiplayer with quick match, private rooms, and session persistence</li>
      <li>Multiple board themes and piece styles</li>
      <li>Complete move history with undo/redo and PDN export</li>
    </ul>
    <p>
      The game ensures a polished experience with sound effects, keyboard navigation,
      high contrast modes, smooth animations, and game history replay. It also
      includes comprehensive rules documentation for every variant and adaptive
      board orientation.
    </p>
  </description>
