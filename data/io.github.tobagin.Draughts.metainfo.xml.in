  <releases>
    <release version="2.2.0" date="2026-01-20">
      <description>
        <p>This release focuses on improving the mobile experience and visual polish:</p>
        <ul>
          <li>Improved layout for mobile devices with Adw.ToolbarView</li>
          <li>Enhanced timer readability with updated fonts and styling</li>
          <li>Cleaner move history navigation on smaller screens</li>
          <li>Fixed Ko-fi badge styling and other UI details</li>
        </ul>
      </description>
    </release>
    <release version="2.1.1" date="2026-01-12">
      <description>
        <p>Metadata improvements: Updated summary and description for better clarity and compliance.</p>
        <p>This release also includes updated store screenshots to reflect the current UI.</p>
      </description>
    </release>
    <release version="2.1.0" date="2026-01-10">
      <description>
        <p>This major update introduces a sophisticated Position Evaluator which considers material, center control, and piece safety for stronger gameplay. The AI now utilizes an extensive Opening Book with standard openings like "Old Faithful".</p>
        <p>We've also added fresh new application icons (thanks to @oiimrosabel) and resolved various deprecation warnings and compilation issues.</p>
      </description>
    </release>
    <release version="2.0.4" date="2025-12-12">
      <description>
        <p>This release fixes backward capture for the International draughts variant and resolves missing translations in Flatpak.</p>
      </description>
    </release>
    <release version="2.0.3" date="2025-10-21">
      <description>
        <p>Added Russian translation (thanks to Vladislav) and updated contributor credits.</p>
      </description>
    </release>
    <release version="2.0.2" date="2025-10-21">
      <description>
        <p>Cleanup and maintenance release, removing unused tools and tidying up the codebase.</p>
      </description>
    </release>
    <release version="2.0.1" date="2025-10-06">
      <description>
        <p>Stability and connection improvements for online multiplayer, including centralized WebSocket management, session state fixes, and better error handling for rooms.</p>
      </description>
    </release>
    <release version="2.0.0" date="2025-10-06">
      <description>
        <p>Major update: Online Multiplayer with extensive improvements.</p>
        <p>Play draughts online against opponents worldwide in real-time with quick matches or private rooms. Features include automatic session persistence, game state restoration, and resignation functionality.</p>
        <p>This release also brings UI enhancements like adaptive board orientation, new multiplayer dialogs, and a statistics dashboard.</p>
      </description>
    </release>
    <release version="1.0.1" date="2025-10-03">
      <description>
        <p>Mobile-friendly update with improved adaptive design. Features full mobile support, adaptive dialogs, optimized game replay, and better cheat controls on small screens.</p>
      </description>
    </release>
    <release version="1.0.0" date="2025-10-02">
      <description>
        <p>First stable release featuring 16 international game variants, 10 AI difficulty levels, diverse piece styles and board themes, and comprehensive accessibility support.</p>
      </description>
    </release>
  </releases>
</component>